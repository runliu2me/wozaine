+void Application::OpenAudioChannelAsync(std::function<void(bool)> done) {
+    if (!protocol_) {
+        done(false);
+        return;
+    }
+    if (connecting_) {
+        // 已经有一次连接在进行（比如后台预连）：排队等它的结果，别丢掉这次请求
+        connect_waiters_.push_back(std::move(done));
+        return;
+    }
+    connecting_ = true;
+    connecting_since_us_ = esp_timer_get_time();
+    connect_waiters_.push_back(std::move(done));
+    xTaskCreate([](void* arg) {
+        auto* app = static_cast<Application*>(arg);
+        bool ok = app->protocol_ ? app->protocol_->OpenAudioChannel() : false;
+        app->Schedule([app, ok]() {
+            app->connecting_ = false;
+            auto waiters = std::move(app->connect_waiters_);
+            app->connect_waiters_.clear();
+            for (auto& w : waiters) {
+                w(ok);
+            }
+        });
+        vTaskDelete(NULL);
+    }, "open_channel", 16384, this, 5, nullptr);   // TLS 握手在这个任务里，8K 会溢出
+}
