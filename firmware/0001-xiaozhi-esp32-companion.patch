+void Application::StartConversation() {
+    CrashInfo::Breadcrumb("tap:start_conversation");
+    // 和 HandleStartListeningEvent 一样的流程，只是用 kListeningModeAutoStop：
+    // 设备把音频一直流给服务器、由服务器断句；tts stop 之后自动回到 Listening（见 tts 消息处理），
+    // 直到用户再拍一下（StopListening）或服务器发 conversation/end。
+    Schedule([this]() {
+        // 用户拍了按钮 = 之前的报错（比如 WiFi 连不上服务器）可以撤了。
+        // 不撤的话 last_error_message_ 一直非空，回到待命时 idle 分支会跳过
+        // ClearChatMessages()，屏幕底下的字幕就一直留着
+        DismissAlert();
+        auto state = GetDeviceState();
+        if (state == kDeviceStateNotifying) {
+            StopNotification();
+            state = kDeviceStateIdle;
+        }
+        if (!protocol_) {
+            return;
+        }
+        if (state == kDeviceStateIdle) {
+            if (!protocol_->IsAudioChannelOpened()) {
+                SetDeviceState(kDeviceStateConnecting);
+                Schedule([this]() { ContinueOpenAudioChannel(kListeningModeAutoStop); });
+                return;
+            }
+            SetListeningMode(kListeningModeAutoStop);
+        } else if (state == kDeviceStateSpeaking) {
+            AbortSpeaking(kAbortReasonNone);
+            SetListeningMode(kListeningModeAutoStop);
+        }
+    });
+}
