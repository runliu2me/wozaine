+void Application::NoteServerContact() {
+    last_server_contact_us_ = esp_timer_get_time();
+}
+
+// 每秒由主循环调用一次
+void Application::SelfHealTick() {
+    const int64_t now = esp_timer_get_time();
+    const auto state = GetDeviceState();
+
+    if (state == kDeviceStateIdle) {
+        if (idle_since_us_ == 0) {
+            idle_since_us_ = now;
+        }
+    } else {
+        idle_since_us_ = 0;
+    }
+
+    // 1) 待命时通道不在（服务器重启、代理超时、连不上……）→ 按退避间隔静默重连
+    if (state == kDeviceStateIdle && protocol_ && !protocol_->IsAudioChannelOpened() &&
+        now - last_prewarm_attempt_us_ > (int64_t)prewarm_backoff_s_ * 1000000) {
+        Schedule([this]() { PrewarmAudioChannelQuiet(); });
+    }
+
+    // 1.5) 连接任务卡死（理论上有 12s+10s+10s 的上限，这里再兜一层）→ 重启
+    if (connecting_ && now - connecting_since_us_ > 90LL * 1000000) {
+        CrashInfo::Breadcrumb("selfheal:connect_stuck_reboot");
+        ESP_LOGE(TAG, "Connect task stuck for 90s, rebooting");
+        Reboot();
+        return;
+    }
+    // 1.6) 内存快耗尽（内部 RAM 空闲 < 40KB 持续 60 秒，且空闲）→ 重启，别等到分配失败 abort
+    {
+        size_t free_internal = heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
+        if (free_internal < 40 * 1024) {
+            if (low_heap_since_us_ == 0) low_heap_since_us_ = now;
+            if (state == kDeviceStateIdle && now - low_heap_since_us_ > 60LL * 1000000) {
+                CrashInfo::Breadcrumb("selfheal:low_heap_reboot");
+                ESP_LOGE(TAG, "Internal heap low (%u bytes) for 60s, rebooting", (unsigned)free_internal);
+                Reboot();
+                return;
+            }
+        } else {
+            low_heap_since_us_ = 0;
+        }
+    }
+
+    // 2) 太久没和服务器说上话（开机起算）→ 重启。WiFi 驱动卡死、协议栈进入奇怪状态等都靠这一招兜底。
+    //    正在升级固件时不重启。
+    if (state != kDeviceStateUpgrading && now - last_server_contact_us_ > kNoContactRebootUs) {
+        CrashInfo::Breadcrumb("selfheal:no_contact_reboot");
+        ESP_LOGE(TAG, "No server contact for %lld minutes, rebooting to self-heal",
+                 (long long)((now - last_server_contact_us_) / 60000000));
+        Reboot();
+        return;
+    }
+
+    // 2.5) 白天主动问候
+    ProactiveTick(now);
+
+    // 3) 每天北京时间凌晨 4 点、设备空闲超过 10 分钟、已运行超过 20 小时 → 例行重启，清掉慢性问题。
+    //    没拿到服务器时间就按运行满 36 小时算。
+    if (state == kDeviceStateIdle && idle_since_us_ != 0 && now - idle_since_us_ > 10LL * 60 * 1000000 &&
+        now > kDailyRebootMinUptimeUs) {
+        bool due = false;
+        if (has_server_time_) {
+            time_t t = time(nullptr);  // OTA 已把系统时间设成北京时间（服务器 timezone_offset=480），这里不能再加 8 小时
+            struct tm tmv;
+            gmtime_r(&t, &tmv);
+            due = (tmv.tm_hour == kDailyRebootHourBeijing);
+        } else {
+            due = now > 36LL * 3600 * 1000000;
+        }
+        if (due) {
+            CrashInfo::Breadcrumb("daily_maintenance_reboot");
+            ESP_LOGI(TAG, "Scheduled maintenance reboot");
+            Reboot();
+        }
+    }
+}
