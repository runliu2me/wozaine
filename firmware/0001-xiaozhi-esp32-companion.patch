+// 后台静默版：失败不弹错误、不响提示音（错误事件会在下一轮主循环被 suppress 掉）
+void Application::PrewarmAudioChannelQuiet() {
+    if (!protocol_ || protocol_->IsAudioChannelOpened() || GetDeviceState() != kDeviceStateIdle) {
+        return;
+    }
+    if (connecting_) {
+        return;
+    }
+    last_prewarm_attempt_us_ = esp_timer_get_time();
+    suppress_next_error_alert_ = true;
+    CrashInfo::Breadcrumb("prewarm_quiet:open_channel");
+    OpenAudioChannelAsync([this](bool ok) {
+        if (ok) {
+            suppress_next_error_alert_ = false;
+            prewarm_backoff_s_ = 30;
+        } else {
+            prewarm_backoff_s_ = std::min(prewarm_backoff_s_ * 2, 300);
+        }
+    });
+}
