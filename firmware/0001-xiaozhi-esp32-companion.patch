+void Application::SetProactiveEnabled(bool enabled) {
+    proactive_enabled_ = enabled;
+    Settings settings("companion", true);
+    settings.SetInt("proactive", enabled ? 1 : 0);
+    ESP_LOGI(TAG, "Proactive check-in %s", enabled ? "enabled" : "disabled");
+}
+
+// 白天（北京时间 10:00–21:00）随机 6–7 次主动开口问候，然后进入连续对话；
+// 对方不回应的话服务器 90 秒自动收掉。日程按天生成：把 11 小时切成 N 段，每段里随机挑一个时刻，天然拉开间隔。
+void Application::ProactiveTick(int64_t now_us) {
+    if (!proactive_enabled_ || !has_server_time_ || !protocol_) {
+        return;
+    }
+    time_t t = time(nullptr);  // OTA 已把系统时间设成北京时间（服务器 timezone_offset=480），这里不能再加 8 小时
+    struct tm tmv;
+    gmtime_r(&t, &tmv);
+    if (tmv.tm_yday != proactive_day_) {
+        proactive_day_ = tmv.tm_yday;
+        proactive_count_ = 6 + (esp_random() % 2);   // 每天 6-7 次
+        const int start = 10 * 60, span = 11 * 60;  // 10:00 起，共 11 小时
+        int slot = span / proactive_count_;
+        for (int i = 0; i < proactive_count_; i++) {
+            proactive_times_[i] = start + i * slot + (int)(esp_random() % slot);
+        }
+        // 开机时已经过了的时间点直接跳过
+        int now_min = tmv.tm_hour * 60 + tmv.tm_min;
+        proactive_next_ = 0;
+        while (proactive_next_ < proactive_count_ && proactive_times_[proactive_next_] <= now_min) {
+            proactive_next_++;
+        }
+        ESP_LOGI(TAG, "Proactive schedule: %d calls today, %d still to go", proactive_count_, proactive_count_ - proactive_next_);
+    }
+    if (proactive_next_ >= proactive_count_) {
+        return;
+    }
+    int now_min = tmv.tm_hour * 60 + tmv.tm_min;
+    if (now_min < proactive_times_[proactive_next_] || now_min >= 21 * 60) {
+        return;
+    }
+    // 到点了：只在待命且已经安静 2 分钟以上时开口（刚聊完不要马上又喊）
+    if (GetDeviceState() != kDeviceStateIdle || idle_since_us_ == 0 || now_us - idle_since_us_ < 2LL * 60 * 1000000) {
+        return;
+    }
+    proactive_next_++;
+    StartProactiveCall();
+}
+
+void Application::StartProactiveCall() {
+    if (!protocol_) {
+        return;
+    }
+    if (!protocol_->IsAudioChannelOpened() && connecting_) {
+        ESP_LOGW(TAG, "Proactive call skipped: still connecting");
+        return;
+    }
+    ESP_LOGI(TAG, "Proactive check-in: starting proactive greeting");
+    CrashInfo::Breadcrumb("proactive_call");
+    // 先告诉服务器"这次是我主动喊的"，它会用主动问候的开场白，而不是被唤起时的应答。
+    // 通道还没开就先记着，等 OnAudioChannelOpened 时再发
+    if (protocol_->IsAudioChannelOpened()) {
+        protocol_->SendCustomText("{\"type\":\"companion\",\"event\":\"proactive\"}");
+    } else {
+        pending_proactive_notice_ = true;
+    }
+    StartConversation();
+}
