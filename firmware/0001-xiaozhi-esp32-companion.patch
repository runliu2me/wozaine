diff --git a/main/crash_info.cc b/main/crash_info.cc
new file mode 100644
index 0000000..80533f2
--- /dev/null
+++ b/main/crash_info.cc
@@ -0,0 +1,74 @@
+#include "crash_info.h"
+#include <esp_system.h>
+#include <esp_attr.h>
+#include <esp_timer.h>
+#include <esp_log.h>
+#include <cstring>
+
+#define TAG "CrashInfo"
+#define CRUMB_MAGIC 0x43524d42u
+
+// RTC 内存：软件复位 / panic / 看门狗复位后内容还在；上电（掉电）复位后是随机值，用 magic 校验
+static RTC_NOINIT_ATTR uint32_t s_magic;
+static RTC_NOINIT_ATTR char s_crumb[48];
+static RTC_NOINIT_ATTR uint32_t s_uptime_s;
+static RTC_NOINIT_ATTR uint32_t s_boot_crashes;
+static RTC_NOINIT_ATTR uint32_t s_power_resets;
+
+static const char* s_reason = "unknown";
+static bool s_crash = false;
+static std::string s_last_crumb;
+static int s_last_uptime = -1;
+static int s_boot_crash_count = 0;
+static int s_power_reset_count = 0;
+
+void CrashInfo::Init() {
+    switch (esp_reset_reason()) {
+        case ESP_RST_POWERON:   s_reason = "power_on"; break;
+        case ESP_RST_SW:        s_reason = "sw_reset"; break;
+        case ESP_RST_PANIC:     s_reason = "panic"; s_crash = true; break;
+        case ESP_RST_INT_WDT:   s_reason = "int_wdt"; s_crash = true; break;
+        case ESP_RST_TASK_WDT:  s_reason = "task_wdt"; s_crash = true; break;
+        case ESP_RST_WDT:       s_reason = "other_wdt"; s_crash = true; break;
+        case ESP_RST_BROWNOUT:  s_reason = "brownout"; s_crash = true; break;
+        case ESP_RST_DEEPSLEEP: s_reason = "deepsleep"; break;
+        case ESP_RST_EXT:       s_reason = "external"; break;
+        case ESP_RST_USB:       s_reason = "usb"; break;
+        default:                s_reason = "unknown"; break;
+    }
+    if (s_magic == CRUMB_MAGIC) {
+        s_crumb[sizeof(s_crumb) - 1] = '\0';
+        s_last_crumb = s_crumb;
+        s_last_uptime = (int)s_uptime_s;
+        bool init_phase = (s_last_crumb == "boot" || s_last_crumb.rfind("init:", 0) == 0);
+        s_boot_crashes = (s_crash && init_phase) ? (s_boot_crashes > 100 ? 1 : s_boot_crashes + 1) : 0;
+        // 掉电复位 + 上次只跑了不到 60 秒 = 电源供不上（电池空了/线不行）。连续几次就进省电开机
+        bool short_run = (s_last_uptime >= 0 && s_last_uptime < 60);
+        bool power_reset = (esp_reset_reason() == ESP_RST_BROWNOUT) || (s_crash && short_run && init_phase);
+        s_power_resets = power_reset ? (s_power_resets > 100 ? 1 : s_power_resets + 1) : 0;
+    } else {
+        s_last_crumb = "";
+        s_last_uptime = -1;
+        s_boot_crashes = 0;
+        s_power_resets = 0;
+    }
+    s_boot_crash_count = (int)s_boot_crashes;
+    s_power_reset_count = (int)s_power_resets;
+    ESP_LOGI(TAG, "reset_reason=%s last_action=\"%s\" uptime_before=%d boot_crashes=%d power_resets=%d", s_reason, s_last_crumb.c_str(), s_last_uptime, s_boot_crash_count, s_power_reset_count);
+    s_magic = CRUMB_MAGIC;
+    s_uptime_s = 0;
+    Breadcrumb("boot");
+}
+
+void CrashInfo::Breadcrumb(const char* what) {
+    strncpy(s_crumb, what, sizeof(s_crumb) - 1);
+    s_crumb[sizeof(s_crumb) - 1] = '\0';
+    s_uptime_s = (uint32_t)(esp_timer_get_time() / 1000000);
+}
+
+const char* CrashInfo::ResetReason() { return s_reason; }
+bool CrashInfo::ResetWasCrash() { return s_crash; }
+std::string CrashInfo::LastBreadcrumb() { return s_last_crumb; }
+int CrashInfo::UptimeBeforeReset() { return s_last_uptime; }
+int CrashInfo::ConsecutiveBootCrashes() { return s_boot_crash_count; }
+int CrashInfo::ConsecutivePowerResets() { return s_power_reset_count; }
diff --git a/main/crash_info.h b/main/crash_info.h
new file mode 100644
index 0000000..3c05d95
--- /dev/null
+++ b/main/crash_info.h
@@ -0,0 +1,15 @@
+// 陪聊项目：崩溃线索。设备放在老人家里拿不到串口日志，所以把"上次为什么重启"和
+// "重启前在干什么"记在 RTC 内存里（重启不丢、断电才丢），开机做 OTA 检查时随 JSON 上报服务器。
+#pragma once
+#include <string>
+
+namespace CrashInfo {
+void Init();                              // 开机第一件事：读复位原因、保存上次面包屑
+const char* ResetReason();                // "power_on" / "sw_reset" / "panic" / "task_wdt" / "int_wdt" / "brownout" ...
+bool ResetWasCrash();                     // panic / 看门狗 / 掉电 都算
+std::string LastBreadcrumb();             // 上次重启前最后一条面包屑
+void Breadcrumb(const char* what);        // 记一条（最多 47 字节）
+int UptimeBeforeReset();                  // 上次运行了多少秒（面包屑里带着）
+int ConsecutiveBootCrashes();             // 连续几次在开机初始化阶段崩溃（RTC 计数，正常开机后清零）
+int ConsecutivePowerResets();             // 连续几次"掉电复位且运行不到 60 秒"（电源不稳）
+}
