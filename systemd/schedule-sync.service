[Unit]
Description=我在呢 · 同步孩子的日历到 data/schedule.json（可选，需在 .env 设 SCHEDULE_ICS_URL）
After=network-online.target

[Service]
Type=oneshot
User=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
Environment=COMPANION_DATA_DIR=__APP_DIR__/data
ExecStart=__APP_DIR__/venv/bin/python3 __APP_DIR__/sync_schedule.py
