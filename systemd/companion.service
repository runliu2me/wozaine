[Unit]
# 永不因为崩溃太频繁而放弃重启
StartLimitIntervalSec=0
Description=我在呢 · 管理台网页 + 接口（127.0.0.1:3093）
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
Environment=LISTEN_HOST=127.0.0.1
Environment=LISTEN_PORT=3093
Environment=WEB_ROOT=__APP_DIR__/web
Environment=COMPANION_DATA_DIR=__APP_DIR__/data
ExecStart=__APP_DIR__/venv/bin/python3 __APP_DIR__/server.py
Restart=always
RestartSec=3
# 管理页面要能自助重启服务生效，走的是 sudo systemctl restart——
# NoNewPrivileges 会从根子上挡掉 sudo 提权，这条不能加在这个服务上
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__APP_DIR__
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
