# ============================================================================
# 我在呢 · 配置文件模板
# 复制成 .env（cp .env.example .env），填好后 chmod 600 .env。.env 不进 git。
# 标「必填」的不填就跑不起来；其他都有默认值，先不用管。
# 部署后，管理台「维护 → 配置」里也能改密钥（改完自动重启服务）。
# ============================================================================

# ---------------------------------------------------------------- 大模型（必填）
# DeepSeek 开放平台 https://platform.deepseek.com 申请，按量付费，一个老人一个月大约几块到十几块钱
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 余额低于多少元时告警
DEEPSEEK_BALANCE_ALERT_BELOW=30

# ---------------------------------------------------------------- 语音识别（必填其一，建议都填）
# 主：阿里云百炼 https://bailian.console.aliyun.com 的 API Key（qwen3-asr-flash，按秒计费）
DASHSCOPE_API_KEY=
# 备：腾讯云「一句话识别」https://console.cloud.tencent.com/asr ，阿里失败时自动顶上
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_ASR_REGION=ap-shanghai
# 识别提示词和热词默认取 family.json 里的 asr_context / asr_hotwords，一般不用在这里改
# ASR_CONTEXT=
# TENCENT_ASR_HOTWORDS=

# ---------------------------------------------------------------- 语音合成（必填）
# 主：MiniMax https://platform.minimaxi.com 。用孩子 10 秒～5 分钟的清晰录音做「快速复刻」得到 voice_id。
# 注意：复刻音色 7 天不用会被平台清掉，keepalive_voices.py（voice-keepalive.timer）会定期保活。
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
# 还没复刻好时可以先用系统音色 male-qn-qingse 跑通流程
MINIMAX_VOICE_ID=
# 管理台「声音」下拉框里的候选（逗号分隔），也是保活列表；不填就只用 MINIMAX_VOICE_ID
MINIMAX_VOICE_IDS=
MINIMAX_TTS_MODEL=speech-2.6-hd
# 接口地址：默认 https://api.minimax.chat/v1/t2a_v2；如果报 invalid api key，换成你账号所在站点的地址试试，
# 比如 https://api.minimaxi.com/v1/t2a_v2（以 MiniMax 控制台文档为准）
# MINIMAX_API_URL=
# 语气：happy / neutral / ...，留空 = 不指定
MINIMAX_TTS_EMOTION=
# 备（可选）：阿里云 CosyVoice 复刻音色，MiniMax 欠费/出错时自动顶上，用上面的 DASHSCOPE_API_KEY
COSYVOICE_VOICE_ID=
COSYVOICE_MODEL=cosyvoice-v3-plus

# ---------------------------------------------------------------- 你的域名（必填）
# 设备通过公网连你的服务器，要一个域名 + HTTPS（deploy/install.sh 会帮你配 nginx 和证书）
XIAOZHI_PUBLIC_WS_URL=wss://YOUR_DOMAIN/xiaozhi/ws
XIAOZHI_PUBLIC_OTA_URL=https://YOUR_DOMAIN/xiaozhi/ota/

# ---------------------------------------------------------------- 管理台登录（对公网开放就必填）
# 运行 venv/bin/python3 admin_password.py 会交互式生成下面三项并写进本文件
ADMIN_USER=admin
ADMIN_DISPLAY_NAME=管理员
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------- 设备安全（强烈建议）
# 管理台调用桥接服务的内部口令（只在服务器本机用）。随便一串长随机字符：openssl rand -hex 24
XIAOZHI_CTL_TOKEN=
# 设备口令：服务器在 OTA 时下发给设备，设备连 WebSocket 时带上。openssl rand -hex 24
XIAOZHI_DEVICE_TOKEN=
# 只允许这些设备（MAC 地址，小写，逗号分隔）。第一次开机后在 journalctl -u xiaozhi-bridge 或管理台「维护」里能看到 MAC
XIAOZHI_ALLOWED_DEVICE_IDS=
# 设备都连上、确认能拿到口令之后改成 1：没口令的连接一律拒绝
XIAOZHI_REQUIRE_DEVICE_TOKEN=0
# 老人那台设备的 MAC，离线告警用（可与白名单里的同一个）
XIAOZHI_ELDER_DEVICE_ID=
# 设备喇叭的采样率（MAC=采样率，逗号分隔）。喇叭 24k 的板子（看板子 config.h 的 AUDIO_OUTPUT_SAMPLE_RATE）填 <它的MAC>=24000；不填按 16000，也能用
XIAOZHI_TX_SAMPLE_RATES=

# ---------------------------------------------------------------- 告警（可选，强烈建议配一个）
# 设备离线、识别/合成欠费、电量低时通知你。KIND：wecom（企业微信群机器人）/ feishu / dingtalk / json
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_KIND=wecom
# 或者本机命令（会以 shell 执行，告警文字从标准输入传入）。只在服务器上亲手配置，不要从不可信来源粘贴。
# 例：mail -s wozaine you@example.com
ALERT_COMMAND=

# ---------------------------------------------------------------- 可选功能
# 孩子日历的 iCal 订阅地址，AI 就知道你最近在忙什么、哪天回家（见 sync_schedule.py）
SCHEDULE_ICS_URL=
# 电话线路：给阿里云/腾讯云「语音智能体」用的 OpenAI 兼容接口 /v1/chat/completions 的口令（见 docs/定制指南.md）
PHONE_API_KEY=
# 用 Tailscale 内网访问管理台时，只放行这个 Tailscale 账号（不用 Tailscale 就留空）
ALLOWED_TAILSCALE_LOGIN=

# ---------------------------------------------------------------- 调参（一般不用动）
# 多少秒没人说话就结束对话
XIAOZHI_IDLE_SECONDS=30
# 设备喇叭整体增益（分贝），老人嫌声音小可以加到 4
XIAOZHI_TTS_GAIN_DB=0
# 电量提醒阈值（%）
XIAOZHI_LOW_BATTERY_PCT=20
# 设备多久没联系算离线（秒）
XIAOZHI_OFFLINE_AFTER=7200
# 错字本每晚最多让 DeepSeek 判多少句
TYPO_NIGHT_BUDGET=800
TYPO_AUTO_NIGHT_BUDGET=120
